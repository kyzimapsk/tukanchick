{
  "name": "tukanchick",
  "version": "0.0.8",
  "description": "Web port for board game: Trails of Tucana",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack/prod.js",
    "start": "webpack serve --config webpack/base.js --open",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "server:build": "tsc -p server/tsconfig.json",
    "server": "node server/dist/server/src/index.js",
    "serve": "npm run build && npm run server:build && npm run server"
  },
  "engines": {
    "node": ">=22.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.3",
    "phaser": "~3.90.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "~5.9.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
